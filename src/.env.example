# GridVision AI — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Required only for live IBM Granite BLUF brief generation.
# Without these, the dashboard uses a high-quality pre-computed brief.
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Flask Application ──────────────────────────────────────────────────────────
# Port for the Flask development server (default: 5000)
PORT=5000
# Set to "true" to enable hot-reload during development
FLASK_DEBUG=false
# Set the Flask secret key if you add sessions (not required for the base demo)
# FLASK_SECRET_KEY=change-me-to-a-random-string
